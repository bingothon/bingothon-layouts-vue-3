{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "open": {
            "type": "boolean",
            "default": true
        },
        "player": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "number": {
                            "type": "number"
                        },
                        "at": {
                            "type": "number",
                            "$comment": "server timestamp of when the press was received"
                        }
                    },
                    "required": ["number", "at"],
                    "additionalProperties": false
                },
                { "type": "null", "$comment": "If no player has pressed the buzzer" }
            ],
            "default": null
        },
        "timeToAnswerMs": {
            "type": "number",
            "default": 10000,
            "$comment": "I'm putting this in the replicant to sync it between server and browser, I don't intend to change this value"
        }
    },
    "required": ["open", "player", "timeToAnswerMs"]
}
