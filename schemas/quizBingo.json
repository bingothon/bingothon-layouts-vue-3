{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "categories": {
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "default": ["Category 1", "Category 2", "Category 3", "Category 4", "Category 5"],
            "items": {
                "type": "string"
            }
        },
        "questions": {
            "type": "array",
            "items": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "question": {
                            "type": "string"
                        },
                        "answer": {
                            "type": "string"
                        },
                        "markedPlayer": {
                            "type": "number"
                        },
                        "questionFr": {
                            "type": "string"
                        },
                        "answerFr": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                }
            }
        },
        "currentlySelected": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "row": {
                            "type": "number"
                        },
                        "column": {
                            "type": "number"
                        }
                    },
                    "required": ["row", "column"],
                    "additionalProperties": false,
                    "$comment": "Coordinates of the currently selected question, row = difficulty - 1, column index of category"
                },
                { "type": "null" }
            ],
            "default": null
        },
        "stage": {
            "type": "string",
            "enum": ["board", "question", "answer"],
            "default": "board"
        }
    }
}
