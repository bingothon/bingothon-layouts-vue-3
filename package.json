{
    "name": "bingothon-layouts-vue-3",
    "version": "3.0.0",
    "description": "Template for NodeCG bundles that use Vue.js and TypeScript.",
    "homepage": "https://github.com/zoton2/nodecg-vue-ts-template#readme",
    "bugs": {
        "url": "https://github.com/zoton2/nodecg-vue-ts-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zoton2/nodecg-vue-ts-template.git"
    },
    "license": "MIT",
    "author": "zoton2",
    "type": "module",
    "scripts": {
        "autofix": "eslint --fix --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prebuild": "trash ./extension && trash ./node_modules/.vite && trash ./shared/dist && trash ./dashboard && trash ./graphics",
        "build": "vite build && tsc -b tsconfig.extension.json",
        "lint": "eslint --max-warnings 0",
        "schema-types": "nodecg schema-types",
        "start": "cd ../.. && node index.js",
        "watch": "conc -n B,E -c red,blue -k vite \"tsc -b -w --preserveWatchOutput tsconfig.extension.json\"",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@quasar/extras": "^1.18.0",
        "@quasar/vite-plugin": "^1.12.0",
        "@tsconfig/node22": "^22.0.5",
        "@types/node": "^22.19.20",
        "@typescript-eslint/parser": "^8.57.2",
        "@unhead/vue": "^1.11.20",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/eslint-config-typescript": "^14.8.0",
        "@vue/tsconfig": "^0.7.0",
        "concurrently": "^9.2.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "nodecg": "^2.6.4",
        "nodecg-vue-composable": "^1.1.0",
        "prettier": "^3.8.3",
        "quasar": "^2.19.3",
        "sass-embedded": "^1.100.0",
        "trash-cli": "^6.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^6.4.3",
        "vite-plugin-checker": "^0.9.3",
        "vite-plugin-nodecg": "^2.1.0",
        "vue": "^3.5.13",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^2.2.12"
    },
    "pnpm": {
        "overrides": {
            "vite-plugin-nodecg>vite": "$vite"
        }
    },
    "nodecg": {
        "compatibleRange": "^2.3.0",
        "dashboardPanels": [
            {
                "name": "crop control",
                "title": "crop control",
                "fullbleed": true,
                "file": "crop-control/main.html",
                "headerColor": "#008BB9"
            },
            {
                "name": "theme control",
                "title": "theme control",
                "file": "theme-control/main.html",
                "width": 2,
                "workspace": "Misc"
            },
            {
                "name": "Z - Host Dashboard",
                "title": "Z - Host Dashboard",
                "file": "host-dashboard/main.html",
                "fullbleed": true
            },
            {
                "name": "Z - Restream Dashboard",
                "title": "Z - Restream Dashboard",
                "file": "restream-dashboard/main.html",
                "fullbleed": true
            }
        ],
        "graphics": [
            {
                "file": "hls-player/main.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "game-layout/main.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "intermission/main.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "cam-names/main.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "interview/main.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "video-player/main.html",
                "width": 1920,
                "height": 1080
            }
        ],
        "mount": [
            {
                "directory": "assets",
                "endpoint": "assets"
            }
        ]
    },
    "overrides": {
        "vite-plugin-nodecg": {
            "vite": "$vite"
        }
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/vue-fontawesome": "^3.2.0",
        "hls.js": "^1.6.16",
        "speedcontrol-util": "^0.6.1",
        "vue-router": "5.0",
        "vue3-apexcharts": "^1.11.1"
    },
    "lint-staged": {
        "*.{cjs,json,css,scss,htm,html,md,yml,yaml}": "prettier --write",
        "*.{ts,vue}": [
            "eslint --fix --max-warnings 0 --no-warn-ignored",
            "prettier --write"
        ]
    }
}
